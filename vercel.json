{
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/",
            "has": [
                {
                    "type": "host",
                    "value": ".*(superadmin|nls-admin).*"
                }
            ],
            "dest": "/nlsadmin/index.html"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "status": 404,
            "dest": "/404.html"
        }
    ]
}