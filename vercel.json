{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "nls-belajar.vercel.app"
                }
            ],
            "destination": "/belajar/index.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "belajar.next-level-study.com"
                }
            ],
            "destination": "/belajar/index.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "nls-superadmin.vercel.app"
                }
            ],
            "destination": "/nlsadmin/index.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "admin.next-level-study.com"
                }
            ],
            "destination": "/nlsadmin/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/belajar",
            "has": [
                {
                    "type": "host",
                    "value": "nls-belajar.vercel.app"
                }
            ],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/belajar/",
            "has": [
                {
                    "type": "host",
                    "value": "nls-belajar.vercel.app"
                }
            ],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/nlsadmin",
            "has": [
                {
                    "type": "host",
                    "value": "nls-superadmin.vercel.app"
                }
            ],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/nlsadmin/",
            "has": [
                {
                    "type": "host",
                    "value": "nls-superadmin.vercel.app"
                }
            ],
            "destination": "/",
            "permanent": false
        }
    ]
}