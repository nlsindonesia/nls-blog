{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/login",
            "destination": "/login/index.html"
        },
        {
            "source": "/register",
            "destination": "/login/index.html"
        },
        {
            "source": "/((?!api/|_next/|favicon|login|register|.*\\..*).*)",
            "has": [
                {
                    "type": "host",
                    "value": "nls-belajar.vercel.app"
                }
            ],
            "destination": "/belajar"
        },
        {
            "source": "/((?!api/|_next/|favicon|login|register|.*\\..*).*)",
            "has": [
                {
                    "type": "host",
                    "value": "belajar.next-level-study.com"
                }
            ],
            "destination": "/belajar"
        },
        {
            "source": "/((?!api/|_next/|favicon|login|register|.*\\..*).*)",
            "has": [
                {
                    "type": "host",
                    "value": "nls-superadmin.vercel.app"
                }
            ],
            "destination": "/nlsadmin"
        },
        {
            "source": "/((?!api/|_next/|favicon|login|register|.*\\..*).*)",
            "has": [
                {
                    "type": "host",
                    "value": "admin.next-level-study.com"
                }
            ],
            "destination": "/nlsadmin"
        }
    ]
}