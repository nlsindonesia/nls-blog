# TLX Remote Judge Configuration

# Server Port
PORT=3500

# Submitter Behavior
# HEADLESS=true -> berjalan di background tanpa membuka jendela browser
# HEADLESS=false -> buka browser tampak (bagus untuk debugging)
HEADLESS=true

# Jeda waktu antar submisi (dalam milidetik) agar tidak melanggar rate limit TLX
# Rekomendasi: 8000 (8 detik)
SUBMISSION_DELAY_MS=8000

# Maksimal waktu tunggu hasil penilaian (ms)
JUDGING_TIMEOUT_MS=60000

# Jalur file session login
SESSION_PATH=./session/tlx_session.json
